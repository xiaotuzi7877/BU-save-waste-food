# Use a development database that you control.
DATABASE_URL=postgresql://portfolio:change-me@127.0.0.1:5432/savefood
JWT_SECRET=replace-with-a-long-random-development-secret
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional email. Leave the API key blank to disable delivery locally.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
# Test sender can only deliver to this explicitly configured mailbox,
# and only when that mailbox was among the intended recipients.
RESEND_TEST_EMAIL=
